    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "*.deprecated": {
                "strikethrough": true
            },
            "class:csharp": "#4ec9b0",
            "delegate:csharp": "#4ec9b0",
            "enum:csharp": "#b8d7a3",
            "interface:csharp": "#b8d7a3",
            "namespace:csharp": "#d4d4d4",
            "struct:csharp": "#86c691",
            "typeParameter:csharp": "#b8d7a3",
            "class.record:csharp": "#dcdcdc",
            "struct.record:csharp": "#dcdcdc"
