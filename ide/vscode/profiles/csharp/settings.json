{
    "editor.fontSize": 12.5,
    "editor.colorDecorators": true,
    "editor.fontFamily": "'Cascadia Mono', Consolas, 'Cascadia Code',  'Courier New',  monospace",
    "editor.fontWeight": "normal",
    "editor.lineHeight": 19,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "none",
    "editor.wordWrap": "off",
    "editor.scrollBeyondLastLine": true,
    "editor.dragAndDrop": true,
    "editor.mouseWheelZoom": false,
    "editor.renderLineHighlight": "line",
    "editor.selectionHighlight": true,
    "editor.occurrencesHighlight": "singleFile",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": false,
    "editor.inlayHints.enabled": "on",
    "editor.stickyScroll.enabled": false,
    "editor.autoClosingBrackets": "languageDefined",
    "editor.autoClosingQuotes": "languageDefined",
    "editor.formatOnSave": true,
    "editor.formatOnType": false,
    "editor.codeLens": true,
    "editor.suggestOnTriggerCharacters": true,
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "editor.parameterHints.enabled": true,
    "editor.showFoldingControls": "mouseover",
    "editor.glyphMargin": true,
    "editor.lineNumbers": "on",
    "editor.rulers": [],
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.linkedEditing": true,
    "editor.multiCursorModifier": "alt",
    "files.autoSave": "off",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.encoding": "utf8",
    "workbench.fontAliasing": "default",
    "workbench.sideBar.location": "right",
    "workbench.panel.defaultLocation": "bottom",
    "window.titleBarStyle": "custom",
    "workbench.editor.showTabs": "multiple",
    "window.density.editorTabHeight": "compact",
    "workbench.editor.tabSizing": "fit",
    "workbench.editor.wrapTabs": false,
    "workbench.editor.closeEmptyGroups": true,
    "workbench.startupEditor": "none",
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "always",
    "breadcrumbs.enabled": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
        "*.csproj": "${capture}.csproj.*",
        "*.json": "${capture}.*.json",
        "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
        "*.razor": "${capture}.razor.cs,${capture}.razor.css",
        "*.resx": "${capture}.Designer.cs",
        "*.xaml": "${capture}.xaml.cs",
        "*.css": "${capture}.min.css",
        "*.min.css": "${capture}.min.css.*",
        "Dockerfile": "Dockerfile.*, .dockerignore"
    },
    "explorer.compactFolders": true,
    "explorer.confirmDelete": false,
    "explorer.sortOrder": "default",
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "testing.openTesting": "neverOpen",
    "debug.toolBarLocation": "floating",
    "debug.inlineValues": "on",
    "debug.showBreakpointsInOverviewRuler": true,
    "debug.console.fontSize": 14,
    "debug.console.fontFamily": "'Cascadia Mono', Consolas, 'Courier New', monospace",
    "debug.openDebug": "openOnDebugBreak",
    "debug.saveBeforeStart": "allEditorsInActiveGroup",
    "debug.console.closeOnEnd": false,
    "git.blame.statusBarItem.enabled": false,
    "git.decorations.enabled": true,
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "terminal.integrated.fontFamily": "'Cascadia Mono', Consolas, 'Courier New', monospace",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.scrollback": 10000,
    "problems.decorations.enabled": true,
    "workbench.iconTheme": "vscode-icons",
    "workbench.list.smoothScrolling": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.hover.delay": 500,
    "editor.lightbulb.enabled": "on",
    "editor.semanticHighlighting.enabled": true,
    "editor.tokenColorCustomizations": {
