# Personal values substituted into {{PLACEHOLDERS}} by apply.sh.
# Copy to personal.env (git-ignored) and fill in. {{HOME}} is filled automatically.

# XCompose identification snippets (Compose + space + n / e)
FULL_NAME='Your Name'
EMAIL='you@example.com'

# External monitors (hyprctl monitors -> "desc:<description>" or output name like DP-1)
MONITOR_2='desc:Vendor Model Serial'
MONITOR_3='desc:Vendor Model Serial'

# Remmina RDP connections (keyfile format: a domain backslash is written as \\)
VM_RDP_SERVER='localhost:3389'
VM_RDP_USERNAME='user'
NUCLEUS_RDP_SERVER='localhost:3389'
NUCLEUS_RDP_USERNAME='DOMAIN\\user'

# SSH keys loaded into ssh-agent at login (space separated; %h is your home)
SSH_KEYS='%h/.ssh/id_ed25519 %h/.ssh/id_work'
